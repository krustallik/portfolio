FROM node:24.21.0-bookworm-slim AS node-lts

FROM mcr.microsoft.com/playwright:v1.64.1-noble AS e2e
COPY --from=node-lts /usr/local/bin/node /usr/local/bin/node
COPY --from=node-lts /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN node --version && npm --version && npm ci
COPY . .
CMD ["npm", "run", "e2e"]
